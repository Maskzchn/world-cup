{
  "manifest_version": 3,
  "name": "CC Browser Bridge",
  "version": "2.0.0",
  "description": "Let your local Claude Code read and edit pages in your real, logged-in browser (CDP + DOM, with DingTalk doc support).",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "scripting", "activeTab", "storage", "alarms", "debugger", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CC Browser Bridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
